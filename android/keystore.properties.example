# Release signing — NOT committed. Copy this file to `keystore.properties` and fill it in.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore zlt-release.jks -alias zlt -keyalg RSA -keysize 2048 \
#           -validity 10000
#
# Then keep the keystore and this file out of version control and safe.

storeFile=/absolute/path/to/zlt-release.jks
storePassword=
keyAlias=zlt
keyPassword=
