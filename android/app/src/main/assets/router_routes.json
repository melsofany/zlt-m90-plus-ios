{
  "version": 2,
  "_comment": "مسارات Firmware جهاز ZLT M90 Plus. عدّل هذا الملف فقط عند ربط جهاز حقيقي. لا تضع كلمات مرور أو رموز جلسة في هذا الملف.",
  "requestTimeoutSeconds": 12,
  "connectTimeoutSeconds": 8,
  "encoding": "json",
  "probe": {
    "url": "http://connectivitycheck.gstatic.com/generate_204",
    "expectedStatus": 204
  },
  "protocols": {
    "_comment": "عائلات واجهة الجهاز. goform هي واجهة ZLT M90 Plus الفعلية، و luci بديل احتياطي للإصدارات الأقدم. عند إضافة اسم آخر يجب إضافة دعمه في الكود.",
    "order": [
      "goform",
      "luci"
    ]
  },
  "goform": {
    "_comment": "واجهة GoAhead/ZTE-Tozed: قراءة عبر goform_get_cmd_process وكتابة عبر goform_set_cmd_process. رموز النجاح 0 و4 تعني نجاح تسجيل الدخول، و3 تعني كلمة مرور خاطئة.",
    "getPath": "/goform/goform_get_cmd_process",
    "setPath": "/goform/goform_set_cmd_process",
    "sessionCheckCmd": "loginfo",
    "sessionOkValue": "ok",
    "loginGoformId": "LOGIN",
    "logoutGoformId": "LOGOUT",
    "loginUserField": "user",
    "loginPasswordField": "password",
    "loginPasswordEncoding": "base64",
    "username": "admin",
    "successResultCodes": [
      "0",
      "4"
    ],
    "wrongPasswordResultCodes": [
      "3"
    ],
    "sessionTokenAliases": [
      "stok",
      "token",
      "sessionid",
      "sysauth"
    ],
    "commands": {
      "deviceInfo": "imei,imsi,iccid,msisdn,cr_version,wa_inner_version,hardware_version,mac_address,lan_ipaddr,wan_ipaddr,network_type,network_provider,wifi_cur_state,realtime_time",
      "battery": "battery_value,battery_charging,battery_vol_percent,battery_pers",
      "network": "network_type,network_provider,ppp_status,modem_main_state,signalbar,network_signalbar,rssi,lte_rsrp,Z5g_rsrp,lte_rsrq,lte_snr,sinr,lan_ipaddr,wan_ipaddr,wan_connect_status,wifi_access_sta_num",
      "dataUsage": "monthly_tx_bytes,monthly_rx_bytes,realtime_tx_bytes,realtime_rx_bytes,realtime_time,data_volume_limit_size,data_volume_limit_unit,data_volume_limit_switch,data_volume_alert_percent,monthly_time",
      "connectedDevices": "station_list,lan_station_list"
    },
    "writes": {
      "updateWifi": {
        "goformId": "SET_WIFI_SSID1_SETTINGS",
        "fields": {
          "ssid": "{ssid}",
          "passphrase": "{password}"
        }
      },
      "restartRouter": {
        "goformId": "REBOOT_DEVICE"
      }
    }
  },
  "routes": {
    "_comment": "مسارات LuCI القديمة، تُستخدم فقط إن لم يستجب goform.",
    "login": {
      "path": "/cgi-bin/luci/api/xqsystem/login",
      "method": "POST",
      "body": {
        "username": "{username}",
        "password": "{password}"
      },
      "successIndicators": [
        "token",
        "stok",
        "success",
        "ok"
      ],
      "failureIndicators": [
        "error",
        "invalid",
        "denied",
        "forbidden"
      ]
    },
    "deviceInfo": {
      "path": "/cgi-bin/luci/api/xqsystem/router_info",
      "method": "GET"
    },
    "battery": {
      "path": "/cgi-bin/luci/api/xqsystem/battery_status",
      "method": "GET"
    },
    "network": {
      "path": "/cgi-bin/luci/api/xqsystem/network_status",
      "method": "GET"
    },
    "dataUsage": {
      "path": "/cgi-bin/luci/api/xqsystem/data_usage",
      "method": "GET"
    },
    "connectedDevices": {
      "path": "/cgi-bin/luci/api/xqsystem/device_list",
      "method": "GET"
    },
    "updateWifi": {
      "path": "/cgi-bin/luci/api/xqsystem/set_wifi",
      "method": "POST",
      "body": {
        "ssid": "{ssid}",
        "password": "{password}"
      }
    },
    "restartRouter": {
      "path": "/cgi-bin/luci/api/xqsystem/reboot",
      "method": "POST"
    }
  },
