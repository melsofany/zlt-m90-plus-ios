<?xml version="1.0" encoding="utf-8"?>
<!--
  Local device access only.

  The ZLT M90 Plus admin interface is plain HTTP and its LAN address is not fixed: factory
  builds ship with 192.168.8.1, 192.168.1.1, 192.168.70.1 or 192.168.100.1 depending on the
  carrier, and a user who renumbered the LAN can place the device on any private subnet. Android
  matches literal host names only (no CIDR), so enumerating a handful of gateway addresses blocked
  every other subnet and the app could not reach the device at all.

  Cleartext is therefore permitted at the base level and the restriction is enforced in code:
  RouterUrl.base rejects any host outside RFC1918 / link-local space before it builds a request,
  so this exemption can never be used for a public address. The trust anchors are the platform's
  own; the router's self-signed certificate is handled per-request in OkHttp, not by weakening the
  anchors here.
-->
<network-security-config>
    <!--suppress InsecureBaseConfiguration (scoped to private hosts in RouterUrl.base) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>