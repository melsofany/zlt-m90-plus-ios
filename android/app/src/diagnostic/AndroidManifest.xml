<?xml version="1.0" encoding="utf-8"?>
<!--
  Diagnostic variant: swaps in the Application class that installs the traffic reporter.
  Merged onto the main manifest, so everything else (permissions, activity) stays identical.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".DiagnosticApplication"
        tools:replace="android:name" />
</manifest>
